# ==============================================
# LARAXOT MODULE: XOT (base module) — .gitignore
# Grouped, deduped. See docs/wiki/rules/module-theme-root-cleanup.md
# ==============================================

# --- Dependencies & packages ---
vendor/
node_modules/
docs/vendor/
package-lock.json
yarn.lock
composer.lock

# --- Build & compiled ---
build/
dist/
cache/
bootstrap/compiled.php
docs/cache/
docs/phpstan/
packages/cache/
packages/temp/

# --- Cache & temporary ---
*.cache
*.lock
*.phar
*.jar
*.tmp
*.swp
*.swo
*.stackdump
*:Zone.Identifier
v8-compile-cache-*
.php-cs-fixer.cache
.phpunit.result.cache

# --- Logs ---
*.log
error_log
npm-debug.log*
yarn-error.log*
lerna-debug.log*

# --- Laravel runtime ---
app/storage/
public/storage
public/hot
public_html/storage
public_html/hot
storage/*.key
.env
.env.*
!.env.example

# --- Environment & IDE ---
Homestead.yaml
Homestead.json
/.vagrant
/.idea
.phpintel
.phpstorm.meta.php
.windsurf/
.cursor/
.vscode/
.devcontainer/

# --- Git leftovers (merge/rebase/editor) ---
.git-rewrite/
.git-blame-ignore-revs
*~HEAD
*~BASE
*~LOCAL
*~REMOTE
*~head
*~
*.orig
*.rej

# --- System files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.exe
agentdb.rvf

# --- Copy / backup / old files ---
* copy
* copy.*
* copy/
*.copy
*.old
*.old1
*.old2
*.backup
*.backup.*
*.backup-*
*.backup_*
*.bak
*.bakcup
*.new

# --- Legacy directories (historic cleanup) ---
resources/views/Components_old/
database/Migrations_old/
database/Seeders_old/
database/Factories_old/
database/Factories_
database_old/
_docs/
lang/lang/
Helpers/
docs/assets/

# --- Project-specific (Xot) ---
*.fila2
*.pest.php
test.txt
testbench.yaml
config/local.php
config/development.php

# ==============================================
# AI/TOOL SCAFFOLD — must never exist in the module tree.
# Generated by AI agents / external CI, never part of the module domain.
# See docs/wiki/rules/module-theme-root-cleanup.md
# Patterns cover both module root and nested occurrences (docs/**).
# ==============================================
_bmad-output/
test-results/
audit-coverage/
tests/AuditCoverage/
.claude-audit/
tests/.claude-audit/
.circleci/
.kilocode/
.kiro/
.ralph/
scripts/
bashscripts/
docs/scripts/
docs/bashscripts/
docs/archive/
docs/archived/
docs/legacy/
docs/workbench/
docs/**/archive/
docs/**/archived/
docs/**/legacy/
docs/**/workbench/
docs/**/scripts/
docs/**/bashscripts/
