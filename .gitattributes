# Prototype: laravel/Modules/* e laravel/Themes/*
# Canon: docs/wiki/rules/no-git-lfs.md
# Sync: bash bashscripts/templates/sync-gitattributes-modules.sh
#
# Git LFS VIETATO. Binari = blob git normali.
* text=auto
*.css linguist-vendored
*.scss linguist-vendored
*.js linguist-vendored
CHANGELOG.md export-ignore
# Binary files (regular git blobs — NO git-lfs)
# `binary` + `!filter` azzera eventuali filtri LFS ereditati.
# Non aggiungere righe `*.png !text ...`: rendono `text` non specificato e,
# con `eol=lf` ereditato da laravel/.gitattributes, Git tratta i PNG come testo.
*.png binary !filter
*.jpg binary !filter
*.jpeg binary !filter
*.gif binary !filter
*.webp binary !filter
*.ico binary !filter
*.svg binary !filter
*.psd binary !filter
*.pdf binary !filter
*.zip binary !filter
*.woff binary !filter
*.woff2 binary !filter
*.ttf binary !filter
*.eot binary !filter
*.otf binary !filter
*.phar binary !filter
*.db binary !filter
*.sqlite binary !filter
